# Public API origin for the browser and RSC fetchers. Required for production builds. No secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Public storefront origin for metadataBase / canonical URLs. No secrets.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3100
# OpenAPI document URL used by `npm run api:generate` (default: ${NEXT_PUBLIC_API_BASE_URL}/api/docs-json).
# A trailing -json is appended automatically unless the URL already ends in -json or .json.
API_OPENAPI_URL=http://localhost:3000/api/docs-json
# Extra image origins for next/image + ProductImage, read at build time. The API
# origin above is always allowed. Format: [scheme://]host[:port], https assumed.
# An invalid entry fails next dev / next build.
# Example: cdn.example.com,images.example.com:8443
NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=
# Build-time opt-ins, off by default. true accepts a localhost or 127.0.0.1
# NEXT_PUBLIC_STOREFRONT_ORIGIN in production (local demo images only).
# NEXT_PUBLIC_ALLOW_LOOPBACK_ORIGIN=true
# true lets next/image optimize images from local or private IPs (SSRF risk; private networks only).
# IMAGES_ALLOW_LOCAL_IP=true
# Run-time overrides read by the server (Docker image), not inlined. API_BASE_URL is the
# origin the browser calls (served by /runtime-config.js); API_INTERNAL_BASE_URL is for
# server-side fetches, for example http://api:3000 inside a Compose network.
# API_BASE_URL=
# API_INTERNAL_BASE_URL=
