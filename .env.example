# Public API origin for the browser and RSC fetchers. No secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Public storefront origin for metadataBase / canonical URLs. No secrets.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3100
# Comma-separated image hosts for next/image + ProductImage (optional :port; https assumed).
# Example: cdn.example.com,images.example.com:443
# NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=
