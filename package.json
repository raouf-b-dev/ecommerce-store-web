{
  "name": "ecommerce-store-web",
  "private": true,
  "version": "0.6.0",
  "license": "MIT",
  "author": "Abderaouf Bouzerara <https://github.com/raouf-b-dev>",
  "description": "Customer storefront for the E-commerce Store API.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "dev:mock": "node ./scripts/dev-mock.js",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint . --cache && node scripts/lint-ascii-prose.cjs",
    "lint:fix": "eslint . --cache --fix && node scripts/lint-ascii-prose.cjs --fix",
    "lint:prune": "eslint . --cache --prune-suppressions",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "check:agent": "node scripts/agent-check.mjs",
    "playwright:install": "node ./scripts/playwright-install.mjs",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "api:generate": "node ./scripts/generate-api-client.js",
    "env:init": "node ./scripts/generate-env.js",
    "env:init:force": "node ./scripts/generate-env.js --overwrite",
    "env:init:secrets": "node ./scripts/generate-env.js --secrets-only",
    "env:init:secrets:force": "node ./scripts/generate-env.js --secrets-only --overwrite",
    "assets:stills": "node ./scripts/capture-showcase.js",
    "assets:walkthrough": "node ./scripts/create-walkthrough.js",
    "assets:capture": "npm run assets:stills && npm run assets:walkthrough"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raouf-b-dev/ecommerce-store-web.git"
  },
  "bugs": {
    "url": "https://github.com/raouf-b-dev/ecommerce-store-web/issues"
  },
  "homepage": "https://github.com/raouf-b-dev/ecommerce-store-web#readme",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "msw": true
  }
}
