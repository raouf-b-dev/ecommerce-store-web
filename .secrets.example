# GitHub Actions repository secrets (Settings -> Secrets and variables -> Actions)
# Generate local file: npm run env:init:secrets
# Overwrite existing: npm run env:init:secrets:force
# Then copy from .secrets into GitHub. Do not commit .secrets
#
# Passwords stay in the API docs/development/SEEDING.md. Fill them in .secrets only.

E2E_CUSTOMER_EMAIL=customer@store.local
E2E_CUSTOMER_PASSWORD=
E2E_CUSTOMER_NEW_PASSWORD=
